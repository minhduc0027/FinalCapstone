<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionOverrides>
        <actionName>View</actionName>
        <content>Refund_Accounting_Record_Page</content>
        <formFactor>Large</formFactor>
        <skipRecordTypeSelect>false</skipRecordTypeSelect>
        <type>Flexipage</type>
    </actionOverrides>
    <deploymentStatus>Deployed</deploymentStatus>
    <description
  >The Refund Transaction object stores one PayHub refund identity, integer VND amount, processing status, retry scheduling, and final outcome after successful inspection. Commonly used for refund processing, reconciliation, and accounting review.</description>
    <enableActivities>true</enableActivities>
    <enableReports>true</enableReports>
    <externalSharingModel>Private</externalSharingModel>
    <label>Refund Transaction</label>
    <nameField>
        <displayFormat>RFT-{000000}</displayFormat>
        <label>Refund Transaction Number</label>
        <startingNumber>1</startingNumber>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Refund Transactions</pluralLabel>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
