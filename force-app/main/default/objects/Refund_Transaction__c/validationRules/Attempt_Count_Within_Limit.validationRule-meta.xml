<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Attempt_Count_Within_Limit</fullName>
    <active>true</active>
    <description
  >Reject negative counts; the refund domain applies the current Admin-configured total-attempt limit.</description>
    <errorConditionFormula>Attempt_Count__c &lt; 0</errorConditionFormula>
    <errorMessage>Attempt count cannot be negative.</errorMessage>
</ValidationRule>
